{
  "name": "@myton/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Shared tokens, base styles, components, domain rules and texts of the MyTON fronts",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "files": [
    "src",
    "!src/**/*.test.ts"
  ],
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./domain": "./src/domain/index.ts",
    "./locale": "./src/locale/index.ts",
    "./styles.css": "./src/styles/index.css",
    "./site.css": "./src/styles/site.css",
    "./fonts.css": "./src/styles/fonts.css",
    "./tokens.css": "./src/styles/tokens.css",
    "./i18n": "./src/i18n/index.ts",
    "./text.module.css": "./src/styles/text.module.css",
    "./motion.module.css": "./src/styles/motion.module.css"
  },
  "scripts": {
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@types/three": "0.183.1",
    "lucide-react": "0.454.0",
    "three": "0.183.2"
  },
  "peerDependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "i18next": "^25.10.10",
    "react-i18next": "^16.6.6"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.5.0",
    "i18next": "25.10.10",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "16.6.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "7.3.6",
    "vitest": "5.0.5"
  },
  "peerDependenciesMeta": {
    "i18next": {
      "optional": true
    },
    "react-i18next": {
      "optional": true
    }
  }
}
